# MOBILE (EXPO) — PUBLIC CONFIGURATION
# -------------------------------------
# These values are embedded in the app bundle at build time. NEVER place
# secrets here. Provide via `expo start` environment or an EAS build profile.

# API base URL reachable from the device/emulator. A physical device needs a
# reachable host (LAN IP in dev). Production: https://api.contentra.app
EXPO_PUBLIC_API_URL=http://localhost:4000

# Expo project ID used by Expo push token registration and EAS Update.
EXPO_PUBLIC_PROJECT_ID=