# WEB — PUBLIC CONFIGURATION
# --------------------------
# These values are embedded in the browser bundle. NEVER place secrets here.
# Production must point at the public API domain.

# API base URL reached by the browser. Production: https://api.contentra.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Opt-in preview environment gate. Only honored when the app is built/run with
# NODE_ENV=development or test; a production build ignores it entirely.
NEXT_PUBLIC_DEVELOPMENT_PREVIEW=0