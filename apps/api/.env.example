# API / WORKER — SERVER-ONLY ENVIRONMENT
# --------------------------------------
# The API reads environment from the repo-root .env (dev script uses
# `--env-file=../../.env`). In production these are set by the platform/deploy
# tooling. All values here are SERVER-ONLY: never expose them to clients.
# This file documents the keys, with the production guidance for each.

# Prisma / Postgres (TLS required in production; use prisma migrate deploy)
DATABASE_URL=postgresql://user:password@host:5432/contentra

# Service bind and identity
PORT=4000
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=1

# Origins — production MUST be the real domains
WEB_ORIGIN=https://contentra.app
# APP_ORIGINS=https://contentra.app,https://www.contentra.app
API_ORIGIN=https://api.contentra.app

# Auth & encryption (>=32 chars, random, environment-specific)
SESSION_SECRET=
ENCRYPTION_KEY=
RELEASES_ADMIN_TOKEN=

# Providers (leave blank = truthful "not configured", never fake success)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
STORAGE_ENDPOINT=
STORAGE_BUCKET=contentra
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# STORAGE_PROVIDER=local  # explicit opt-in for single-instance self-host only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
EXPO_ACCESS_TOKEN=
WORKER_POLL_MS=1000

# Social OAuth — <PROVIDER>_CLIENT_ID|_CLIENT_SECRET|_AUTHORIZATION_ENDPOINT|
# _TOKEN_ENDPOINT|_PROFILE_ENDPOINT|_POSTS_ENDPOINT|_METRICS_ENDPOINT|
# _AUDIENCE_ENDPOINT|_PUBLISH_ENDPOINT|_REVOCATION_ENDPOINT|_REDIRECT_URI|
# _SCOPES|_CAPABILITIES for instagram, tiktok, youtube, x

# Optional credit cost overrides (UPPER_SNAKE action names), e.g.
# CREDIT_COST_CREATE_CONTENT=2