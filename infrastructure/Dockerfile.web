# REFERENCE DOCKERFILE — NOT BUILD-VALIDATED IN THIS ENVIRONMENT
# (Docker is not installed in the dev environment; this file documents the
# intended containerization and must be validated on the deploy host.)
#
# Builds the Next.js production bundle with the public API URL, then runs
# `next start`. NEXT_PUBLIC_API_URL must be the public API origin.

# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS build
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps packages services prisma tsconfig.json ./
RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_API_URL=https://api.contentra.app
ARG NEXT_PUBLIC_DEVELOPMENT_PREVIEW=0
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_DEVELOPMENT_PREVIEW=$NEXT_PUBLIC_DEVELOPMENT_PREVIEW
RUN pnpm --filter @contentra/web build

FROM base AS runtime
COPY --from=build /app ./
WORKDIR /app/apps/web
EXPOSE 3000
ENV NODE_ENV=production
CMD ["pnpm", "start"]