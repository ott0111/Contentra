# REFERENCE DOCKERFILE — NOT BUILD-VALIDATED IN THIS ENVIRONMENT
# (Docker is not installed in the dev environment; this file documents the
# intended containerization and must be validated on the deploy host.)
#
# Runs the API from source via tsx (the exact code path verified in production
# mode): `node --import tsx src/server.ts`. Use the same image for the worker by
# overriding the command to `node --import tsx src/worker.ts`.

# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps packages services prisma tsconfig.json ./
RUN pnpm install --frozen-lockfile

WORKDIR /app
EXPOSE 4000
ENV NODE_ENV=production
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/health || exit 1
CMD ["node", "--import", "tsx", "apps/api/src/server.ts"]