# ============================================================
# CONTENTRA — ENVIRONMENT CONFIGURATION (reference copy)
# ============================================================
# Copy this file to `.env` for local development. NEVER commit `.env`.
# Rules:
#   - Anything with a NEXT_PUBLIC_/EXPO_PUBLIC_/VITE_ prefix is embedded in
#     client bundles and shipped to browsers/devices. NEVER put secrets here.
#   - Server-only vars stay in the API/worker process (.env at repo root or
#     apps/api/.env) and are never exposed to clients.
#   - Production values must use the real public domain (https://contentra.app)
#     and real credentials; the values below are development defaults only.

# ============================================================
# CORE / RUNTIME
# ============================================================
# development | test | staging | production
NODE_ENV=development
# API port (0.0.0.0 binding)
PORT=4000
# Log level for the API (pino): info | warn | error | debug
LOG_LEVEL=info
# Set TRUST_PROXY=1 ONLY behind a trusted reverse proxy / load balancer so the
# API honors X-Forwarded-For for rate limiting and IP logging. Leave unset when
# the API is exposed directly (or locally).
TRUST_PROXY=0

# ============================================================
# ORIGINS (defaults are local-development only)
# ============================================================
# Public web origin. Used for CORS allowheader checks and to build
# email/verification/Stripe deep links.
WEB_ORIGIN=http://localhost:3000
# Optional comma-separated allowlist of browser origins the API may accept in
# CORS (e.g. https://contentra.app,https://www.contentra.app). Defaults to
# WEB_ORIGIN when unset. MUST be the production origins in production.
# APP_ORIGINS=https://contentra.app,https://www.contentra.app
# Public API origin used to build OAuth callback URLs. Production:
# API_ORIGIN=https://api.contentra.app
API_ORIGIN=http://localhost:4000

# ============================================================
# DATABASE — SERVER ONLY
# ============================================================
# PostgreSQL connection string. The local credential below is an example only
# and must never be used in production. Production MUST use TLS and a privileged
# user; migrations run with `prisma migrate deploy` (never `migrate dev`).
DATABASE_URL=postgresql://contentra:contentra@localhost:5432/contentra

# ============================================================
# AUTHENTICATION & ENCRYPTION — SERVER ONLY
# ============================================================
# Signs OAuth `state` values (OAuth CSRF protection). Generate a long random
# secret of at least 32 characters. Different value per environment.
SESSION_SECRET=replace-with-a-long-random-session-secret
# Encrypts stored OAuth tokens and other credentials at rest (AES-256-GCM).
# At least 32 characters. MUST be stable per environment or stored tokens
# become undecryptable. Keep a backup; rotating it requires re-linking accounts.
ENCRYPTION_KEY=replace-with-a-long-random-encryption-key
# Admin bearer token that gates /api/v1/releases (release publishing/CI).
RELEASES_ADMIN_TOKEN=

# ============================================================
# AI / GEMINI — SERVER ONLY
# ============================================================
# From Google AI Studio / your key provider. Without it the app starts and AI
# surfaces report "AI provider not configured" (HTTP 503 AI_NOT_CONFIGURED).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# EMAIL — SERVER ONLY
# ============================================================
# Verification/reset/invite messages are POSTed to this webhook URL signed with
# EMAIL_WEBHOOK_SECRET. Without both, the sender is null, no email is sent, and
# flows report delivery as pending. No fake-send is ever performed.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=

# ============================================================
# OBJECT STORAGE — SERVER ONLY
# ============================================================
# S3-compatible/object-storage endpoint plus credentials.
# In production, if these are absent the API FAILS CLOSED with
# STORAGE_NOT_CONFIGURED unless you explicitly opt into the local on-disk
# store with STORAGE_PROVIDER=local (single-instance self-host only).
STORAGE_ENDPOINT=
STORAGE_BUCKET=contentra
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# STORAGE_PROVIDER=local

# ============================================================
# STRIPE — TEST MODE ONLY IS SHOWN HERE; PRODUCTION USES LIVE KEY
# ============================================================
# Never mix test and live credentials between environments. Test keys begin
# sk_test_, webhook secrets begin whsec_; live equivalents in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price IDs (Pro $19.99/month, Business $49.99/month).
# Missing price IDs disable checkout with a clear error; no fake subscription
# state is created.
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# ============================================================
# SOCIAL OAUTH — SERVER ONLY
# ============================================================
# Credentials from each provider's developer portal. Endpoint/scopes are set
# from official provider docs. Client secrets are server-only. Redirect URIs
# must exactly match the app dashboard; publishing/analytics may require
# provider review/approval. Without all required values, connect returns
# HTTP 503 PROVIDER_NOT_CONFIGURED — nothing is faked.
# Pattern:
#   <PROVIDER>_CLIENT_ID / <PROVIDER>_CLIENT_SECRET
#   <PROVIDER>_AUTHORIZATION_ENDPOINT / <PROVIDER>_TOKEN_ENDPOINT
#   <PROVIDER>_PROFILE_ENDPOINT / <PROVIDER>_POSTS_ENDPOINT
#   <PROVIDER>_METRICS_ENDPOINT / <PROVIDER>_AUDIENCE_ENDPOINT
#   <PROVIDER>_PUBLISH_ENDPOINT / <PROVIDER>_REVOCATION_ENDPOINT
#   <PROVIDER>_REDIRECT_URI / <PROVIDER>_SCOPES / <PROVIDER>_CAPABILITIES

# Instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_AUTHORIZATION_ENDPOINT=
INSTAGRAM_TOKEN_ENDPOINT=
INSTAGRAM_PROFILE_ENDPOINT=
INSTAGRAM_POSTS_ENDPOINT=
INSTAGRAM_METRICS_ENDPOINT=
INSTAGRAM_AUDIENCE_ENDPOINT=
INSTAGRAM_PUBLISH_ENDPOINT=
INSTAGRAM_REVOCATION_ENDPOINT=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SCOPES=
INSTAGRAM_CAPABILITIES=profile,refresh

# TikTok
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUTHORIZATION_ENDPOINT=
TIKTOK_TOKEN_ENDPOINT=
TIKTOK_PROFILE_ENDPOINT=
TIKTOK_POSTS_ENDPOINT=
TIKTOK_METRICS_ENDPOINT=
TIKTOK_AUDIENCE_ENDPOINT=
TIKTOK_PUBLISH_ENDPOINT=
TIKTOK_REVOCATION_ENDPOINT=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=
TIKTOK_CAPABILITIES=profile,refresh

# YouTube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_AUTHORIZATION_ENDPOINT=
YOUTUBE_TOKEN_ENDPOINT=
YOUTUBE_PROFILE_ENDPOINT=
YOUTUBE_POSTS_ENDPOINT=
YOUTUBE_METRICS_ENDPOINT=
YOUTUBE_AUDIENCE_ENDPOINT=
YOUTUBE_PUBLISH_ENDPOINT=
YOUTUBE_REVOCATION_ENDPOINT=
YOUTUBE_REDIRECT_URI=
YOUTUBE_SCOPES=
YOUTUBE_CAPABILITIES=profile,refresh

# X
X_CLIENT_ID=
X_CLIENT_SECRET=
X_AUTHORIZATION_ENDPOINT=
X_TOKEN_ENDPOINT=
X_PROFILE_ENDPOINT=
X_POSTS_ENDPOINT=
X_METRICS_ENDPOINT=
X_AUDIENCE_ENDPOINT=
X_PUBLISH_ENDPOINT=
X_REVOCATION_ENDPOINT=
X_REDIRECT_URI=
X_SCOPES=
X_CAPABILITIES=profile,refresh

# ============================================================
# BACKGROUND WORK — SERVER ONLY
# ============================================================
# Jobs persist in PostgreSQL (no separate queue connection). Run the worker via
# `pnpm --filter @contentra/api worker`. Handlers: push_delivery, cleanup.
WORKER_POLL_MS=1000

# ============================================================
# PUSH NOTIFICATIONS — SERVER ONLY
# ============================================================
# Expo push credential. Without it, push jobs resolve as not_configured and no
# delivery is sent; EXPO_ACCESS_TOKEN must never be client-visible.
EXPO_ACCESS_TOKEN=

# ============================================================
# CREDIT COSTS — SERVER ONLY (OPTIONAL)
# ============================================================
# Credit debits for AI actions; the code reads CREDIT_COST_<ACTION> dynamic
# keys (UPPER_SNAKE case), defaulting to 1 when unset.
# CREDIT_COST_CREATE_CONTENT=2

# ============================================================
# WEB — PUBLIC CONFIGURATION (embedded in the browser bundle)
# ============================================================
# Production value: https://api.contentra.app
NEXT_PUBLIC_API_URL=http://localhost:4000
# Opt-in preview environment gate. Effective ONLY when NODE_ENV is
# development/test, so a production build can never enable it.
NEXT_PUBLIC_DEVELOPMENT_PREVIEW=0

# ============================================================
# MOBILE / EXPO — PUBLIC CONFIGURATION
# ============================================================
# Reachable from the emulator/phone; a physical device may need the machine's
# LAN IP. Production value: https://api.contentra.app
EXPO_PUBLIC_API_URL=http://localhost:4000
# Expo project ID used by Expo push token registration / EAS Update.
EXPO_PUBLIC_PROJECT_ID=
# Never put secrets in EXPO_PUBLIC_* variables.

# ============================================================
# DESKTOP / TAURI — PUBLIC CONFIGURATION
# ============================================================
# Embedded into the desktop frontend at build time. Production value:
# https://api.contentra.app
VITE_API_URL=http://localhost:4000