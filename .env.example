# ============================================================
# CONTENTRA
# Environment Configuration
# ============================================================
#
# Copy to `.env` for local development.
# NEVER commit `.env` or production secrets.
#
# PUBLIC VARIABLES:
#   NEXT_PUBLIC_*  → Web
#   EXPO_PUBLIC_*  → Mobile
#   VITE_*         → Desktop
#
# Everything else is SERVER ONLY.
#
# Production domains:
#   Web: https://contentra.app
#   API: https://api.contentra.app
# ============================================================


# ------------------------------------------------------------
# CORE
# ------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0


# ------------------------------------------------------------
# APPLICATION URLS
# ------------------------------------------------------------

WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# Comma-separated production origins.
# APP_ORIGINS=https://contentra.app,https://www.contentra.app


# ------------------------------------------------------------
# DATABASE
# SERVER ONLY
# ------------------------------------------------------------

# Local development:
DATABASE_URL="postgresql://neondb_owner:npg_A5pMYhdDR1sX@ep-fragrant-art-au024deh-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Production should use your managed PostgreSQL connection string.
# Use `prisma migrate deploy` for production migrations.


# ------------------------------------------------------------
# AUTH & ENCRYPTION
# SERVER ONLY
# ------------------------------------------------------------

# Generate a long random value.
SESSION_SECRET=
# Stable encryption key for stored OAuth credentials.
# Changing this invalidates existing encrypted credentials.
ENCRYPTION_KEY=
# Protects the release publishing endpoint.
RELEASES_ADMIN_TOKEN=


# ------------------------------------------------------------
# AI
# SERVER ONLY
# ------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ------------------------------------------------------------
# EMAIL
# SERVER ONLY
# ------------------------------------------------------------

# Contentra's current email architecture uses a signed webhook.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=


# ------------------------------------------------------------
# OBJECT STORAGE
# SERVER ONLY
# ------------------------------------------------------------

STORAGE_ENDPOINT=https://7f9e8802645b7e25028fb4f6261b9c26.r2.cloudflarestorage.com
STORAGE_BUCKET=contentra
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional local development storage:
# STORAGE_PROVIDER=local


# ------------------------------------------------------------
# STRIPE
# SERVER ONLY
# ------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

