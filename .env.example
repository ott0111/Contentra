# SERVER ONLY
# ------------------------------------------------------------

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUTHORIZATION_ENDPOINT=
TIKTOK_TOKEN_ENDPOINT=
TIKTOK_PROFILE_ENDPOINT=
TIKTOK_POSTS_ENDPOINT=
TIKTOK_METRICS_ENDPOINT=
TIKTOK_AUDIENCE_ENDPOINT=
TIKTOK_PUBLISH_ENDPOINT=
TIKTOK_REVOCATION_ENDPOINT=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=
TIKTOK_CAPABILITIES=profile,refresh


# ------------------------------------------------------------
# SOCIAL — YOUTUBE
# SERVER ONLY
# ------------------------------------------------------------

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_AUTHORIZATION_ENDPOINT=
YOUTUBE_TOKEN_ENDPOINT=
YOUTUBE_PROFILE_ENDPOINT=
YOUTUBE_POSTS_ENDPOINT=
YOUTUBE_METRICS_ENDPOINT=
YOUTUBE_AUDIENCE_ENDPOINT=
YOUTUBE_PUBLISH_ENDPOINT=
YOUTUBE_REVOCATION_ENDPOINT=
YOUTUBE_REDIRECT_URI=
