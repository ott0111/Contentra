# ============================================================
# CONTENTRA
# Environment Configuration
# ============================================================
#
# Copy to `.env` for local development.
# NEVER commit `.env` or production secrets.
#
# PUBLIC VARIABLES:
#   NEXT_PUBLIC_*  → Web
#   EXPO_PUBLIC_*  → Mobile
#   VITE_*         → Desktop
#
# Everything else is SERVER ONLY.
#
# Production domains:
#   Web: https://contentra.app
#   API: https://api.contentra.app
# ============================================================


# ------------------------------------------------------------
# CORE
# ------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0


# ------------------------------------------------------------
# APPLICATION URLS
# ------------------------------------------------------------

WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000

# Comma-separated production origins.
# APP_ORIGINS=https://contentra.app,https://www.contentra.app


# ------------------------------------------------------------
# DATABASE
# SERVER ONLY
# ------------------------------------------------------------

# Local development:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/contentra"

# Production should use your managed PostgreSQL connection string.
# Use `prisma migrate deploy` for production migrations.


# ------------------------------------------------------------
# AUTH & ENCRYPTION
# SERVER ONLY
# ------------------------------------------------------------

# Generate a long random value.
SESSION_SECRET=
# Stable encryption key for stored OAuth credentials.
# Changing this invalidates existing encrypted credentials.
ENCRYPTION_KEY=
# Protects the release publishing endpoint.
RELEASES_ADMIN_TOKEN=


# ------------------------------------------------------------
# AI
# SERVER ONLY
# ------------------------------------------------------------

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ------------------------------------------------------------
# EMAIL
# SERVER ONLY
# ------------------------------------------------------------

# Contentra's current email architecture uses a signed webhook.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=


# ------------------------------------------------------------
# OBJECT STORAGE
# SERVER ONLY
# ------------------------------------------------------------

STORAGE_ENDPOINT=https://7f9e8802645b7e25028fb4f6261b9c26.r2.cloudflarestorage.com
STORAGE_BUCKET=contentra
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional local development storage:
# STORAGE_PROVIDER=local


# ------------------------------------------------------------
# PADDLE (Paddle Billing v1)
# SERVER ONLY
# ------------------------------------------------------------
#
# Free is the application default and is NOT a Paddle product. Paid plans:
#   Pro $19.99/month | Business $49.99/month | Agency $99.99/month
#
# Until these are populated, the app runs on Free and checkout returns
# 503 BILLING_NOT_CONFIGURED. Credentials are supplied by the operator from the
# Paddle dashboard (API key / client token / webhook Secret key / price IDs);
# nothing is hardcoded and no Paddle object is created by this repo.

PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=

PADDLE_PRO_PRICE_ID=
PADDLE_BUSINESS_PRICE_ID=
PADDLE_AGENCY_PRICE_ID=

# Internal admin (server only):
# Root owner is bootstrapped on first request when no OWNER exists.
# Admin codes are delivered by email (requires EMAIL_WEBHOOK_URL/SECRET above);
# without them, code requests return 503 ADMIN_EMAIL_NOT_CONFIGURED.
# ADMIN_ROOT_EMAIL=owner@yourcompany.com


# ------------------------------------------------------------
# SOCIAL — INSTAGRAM
# SERVER ONLY
# ------------------------------------------------------------

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_AUTHORIZATION_ENDPOINT=
INSTAGRAM_TOKEN_ENDPOINT=
INSTAGRAM_PROFILE_ENDPOINT=
INSTAGRAM_POSTS_ENDPOINT=
INSTAGRAM_METRICS_ENDPOINT=
INSTAGRAM_AUDIENCE_ENDPOINT=
INSTAGRAM_PUBLISH_ENDPOINT=
INSTAGRAM_REVOCATION_ENDPOINT=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SCOPES=
INSTAGRAM_CAPABILITIES=profile,refresh


# ------------------------------------------------------------
