# ------------------------------------------------------------
# SOCIAL — X
# SERVER ONLY
# ------------------------------------------------------------

X_CLIENT_ID=
X_CLIENT_SECRET=
X_AUTHORIZATION_ENDPOINT=
X_TOKEN_ENDPOINT=
X_PROFILE_ENDPOINT=
X_POSTS_ENDPOINT=
